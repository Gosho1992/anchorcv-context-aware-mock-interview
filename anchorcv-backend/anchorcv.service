[Unit]
Description=AnchorCV FastAPI Backend
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/anchorcv/anchorcv-backend
Environment="PATH=/var/www/anchorcv/venv/bin"
EnvironmentFile=/var/www/anchorcv/anchorcv-backend/.env
ExecStart=/var/www/anchorcv/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 2
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=anchorcv

[Install]
WantedBy=multi-user.target
