# -------------------------------------------------
# AnchorCV local environment example (placeholders)
# -------------------------------------------------
# Copy this file to:
# - anchorcv-backend/.env (backend)
# - .env (optional root tooling)
# and replace placeholders with real values.

# Frontend
VITE_API_BASE=http://localhost:8000/api

# Core AI providers
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
SUPABASE_KEY=your_supabase_anon_or_service_key_here

# Session/auth
ANCHORCV_SESSION_SECRET=replace_with_a_long_random_secret
ANCHORCV_SESSION_COOKIE=anchorcv_session
ANCHORCV_SESSION_MAX_AGE=604800
ANCHORCV_SECURE_COOKIES=false
ANCHORCV_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_URL=http://localhost:5173

# Search/discovery integrations
GOOGLE_SEARCH_API_KEY=your_google_search_api_key_here
GOOGLE_SEARCH_CX=your_google_search_cx_here
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_API_KEY=your_adzuna_api_key_here
SERPER_API_KEY=your_serper_api_key_here

# Payments/webhooks (optional for local dev)
LEMONSQUEEZY_API_KEY=your_lemonsqueezy_api_key_here
LEMONSQUEEZY_WEBHOOK_SECRET=your_lemonsqueezy_webhook_secret_here
LEMONSQUEEZY_CHECKOUT_URL=https://your-checkout-url
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PRICE_ID=your_stripe_price_id_here

# Email/password reset (optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user_here
SMTP_PASS=your_smtp_password_here
SMTP_FROM=noreply@example.com

# Optional local override for Resume Defense DB location
ANCHORCV_RESUME_DEFENSE_DB_PATH=
